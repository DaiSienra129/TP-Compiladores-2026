# Variables de carpetas
SRC_DIR = src
TEST_DIR = tests
OUT_DIR = out

# Regla principal (se ejecuta al escribir 'make')
all: help

help:
	@echo "Opciones disponibles:"
	@echo "  make test   - Ejecuta los escenarios de prueba"
	@echo "  make clean  - Limpia los archivos generados en out/"

# Limpieza de temporales
clean:
	rm -rf $(OUT_DIR)/*